# ---- Base de datos (PostgreSQL / PostGIS) ----
DB_HOST=localhost
DB_PORT=5434
DB_NAME=sismos_db
DB_USER=sismos_user
DB_PASSWORD=TuPasswordSeguraAqui
DB_SSLMODE=prefer
SISMOS_TABLE=public.sismos

# ---- API FastAPI ----
API_PORT=8000
# Dev (WSL2 / Local): 127.0.0.1  |  Prod (knossos / LAN): 0.0.0.0
API_BIND=127.0.0.1
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=

# ---- Inteligencia Artificial Local (Ollama) ----
# [Producción: Knossos (Servidor LAN) - Modelos disponibles: qwen2.5:1.5b y llama3.2:1b]
OLLAMA_BASE_URL=http://192.168.100.16:11434
OLLAMA_MODEL_PARSER=qwen2.5:1.5b
OLLAMA_MODEL_SUMMARY=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=25.0

# [Desarrollo local: GPU host / WSL2 - Modelos 8B]
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL_PARSER=llama3.1:8b
# OLLAMA_MODEL_SUMMARY=llama3.1:8b
# OLLAMA_TIMEOUT_SECONDS=35.0

