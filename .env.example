# ---- Base de datos (PostgreSQL / PostGIS) ----
DB_HOST=localhost
DB_PORT=5434
DB_NAME=sismos_db
DB_USER=sismos_user
DB_PASSWORD=TuPasswordSeguraAqui
DB_SSLMODE=prefer
SISMOS_TABLE=public.sismos

# ---- API FastAPI ----
API_PORT=8000
# Dev (WSL2 / Local): 127.0.0.1  |  Prod (knossos / LAN): 0.0.0.0
API_BIND=127.0.0.1
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=
